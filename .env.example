# Application Configuration
APP_PORT=3000
APP_URL=http://localhost:3000
APP_NAME="REUXIE"
APP_AUTHOR="alcancode"
APP_DESCRIPTION="REUXIE Formation API"
APP_API_PREFIX=api
APP_LICENSE="MIT"
APP_VERSION="1.0.0"
APP_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
NODE_ENV=development

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=formation_db
DATABASE_PORT=5432
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=your_database
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

# For production with connection string (optional)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# PostgreSQL Docker Configuration (for local development)
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database
POSTGRES_PORT=5432
